# Database
DATABASE_URL=postgresql://serviceline:serviceline@localhost:5432/serviceline

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Anthropic
ANTHROPIC_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Stripe (billing). Without STRIPE_SECRET_KEY the billing routes return 503 and
# the app runs normally. Create two recurring Prices in Stripe and put their IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# App
VOICE_SERVER_URL=http://localhost:3001
# IANA timezone the on-call schedule is evaluated in. Production servers run UTC,
# so set this to the business's timezone (e.g. America/Chicago) or on-call windows
# fire at the wrong hours. Unset = server-local time.
DEFAULT_TIMEZONE=
N8N_TEXTBACK_WEBHOOK_URL=http://localhost:5678/webhook/missed-call-textback
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# Admin + session auth (web app — set these in apps/web/.env.local for local dev)
# Signs admin + dashboard session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ADMIN_EMAIL=admin@servicelineai.com
# Provide ONE of: ADMIN_PASSWORD_HASH (bcrypt) or ADMIN_PASSWORD (plaintext, dev only)
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=
